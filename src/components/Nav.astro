---
const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Accounting Services' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Insights' },
  { href: '/faq', label: 'FAQ' },
  { href: '/order', label: 'Online Services' },
  { href: '/contact', label: 'Contact' },
];
---

<!--
  MOBILE MENU (20 Aug 2026). Below md every link was `hidden` with nothing replacing it, so a
  phone visitor saw only the logo and "Request a Quote" — Services, About, Insights, FAQ,
  Online Services and Contact were live but unreachable by navigation. The toggle below md
  opens a panel holding the full list.
-->
<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur">
  <nav class="container-v flex h-[4.5rem] items-center justify-between">
    <a href="/" class="flex shrink-0 items-center">
      <img src="/logo.png" alt="MyFINANCE Online — accountants & business advisors" class="h-8 w-auto sm:h-10" />
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {links.map((l) => (
        <a href={l.href} class="text-sm font-medium text-navy/70 transition-colors hover:text-navy">{l.label}</a>
      ))}
    </div>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <a href="/contact#quote" class="btn-primary shrink-0 !px-3 !py-2 text-xs sm:!px-5 sm:!py-2.5 sm:text-sm">Request a Quote</a>

      <button
        id="nav-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-mobile"
        class="-mr-2 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-navy/70 sm:h-10 sm:w-10 transition-colors hover:bg-slate-100 hover:text-navy md:hidden"
      >
        <svg data-icon="open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg data-icon="close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="nav-mobile" class="hidden border-t border-slate-200 bg-white md:hidden">
    <div class="container-v flex flex-col py-3">
      {links.map((l) => (
        <a href={l.href} class="rounded-lg px-2 py-3 text-base font-medium text-navy/80 transition-colors hover:bg-sky-soft hover:text-navy">{l.label}</a>
      ))}
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('nav-toggle');
    var panel = document.getElementById('nav-mobile');
    if (!btn || !panel) return;

    var iconOpen = btn.querySelector('[data-icon="open"]');
    var iconClose = btn.querySelector('[data-icon="close"]');

    function setOpen(open) {
      panel.classList.toggle('hidden', !open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    }

    btn.addEventListener('click', function () {
      setOpen(panel.classList.contains('hidden'));
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });

    // Widening past the md breakpoint restores the desktop bar; leaving the panel open would
    // otherwise strand a duplicate link list under it.
    window.addEventListener('resize', function () {
      if (window.innerWidth >= 768) setOpen(false);
    });
  })();
</script>
