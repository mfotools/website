---
// Tawk.to chat: the "Myfinance online" property and its own widget, kept apart from Virta's.
const tawk = 'https://embed.tawk.to/68c1af16551a1c19244f8324/1j4q97sou';
---

<div
  id="cookie-notice"
  hidden
  role="region"
  aria-label="Cookie notice"
  class="fixed inset-x-4 bottom-4 z-50 mx-auto max-w-xl rounded-xl border border-navy/10 bg-white p-4 text-sm text-slate-700 shadow-lg sm:inset-x-6"
>
  <p>
    Our chat window (Tawk.to) uses cookies to keep your conversation going from page to page and to show us which
    pages you're on while it's open. Decline and the chat stays off.
  </p>
  <div class="mt-3 flex justify-end gap-2">
    <button type="button" data-cookie-choice="declined" class="rounded-lg px-4 py-2 font-medium text-navy hover:bg-slate-100">Decline</button>
    <button type="button" data-cookie-choice="ok" class="btn-primary !px-4 !py-2">OK</button>
  </div>
</div>

<script is:inline define:vars={{ tawk }}>
  (function () {
    var choice = null;
    try { choice = localStorage.getItem('mfo-cookies'); } catch (e) { /* storage blocked: show the notice */ }

    // LOGIC: opt-out, as on www.virta.co.za: the chat loads unless the visitor declined.
    if (choice !== 'declined') {
      window.Tawk_API = window.Tawk_API || {};
      window.Tawk_LoadStart = new Date();
      var chat = document.createElement('script');
      chat.async = true;
      chat.src = tawk;
      chat.charset = 'UTF-8';
      chat.setAttribute('crossorigin', '*');
      document.head.appendChild(chat);
    }

    var notice = document.getElementById('cookie-notice');
    if (!notice) return;
    if (!choice) notice.hidden = false;

    notice.addEventListener('click', function (e) {
      var button = e.target instanceof Element ? e.target.closest('[data-cookie-choice]') : null;
      if (!button) return;
      var value = button.getAttribute('data-cookie-choice');
      try { localStorage.setItem('mfo-cookies', value); } catch (err) { /* storage blocked: choice lasts this page only */ }
      notice.hidden = true;
      // LOGIC: whether the chat loaded was decided on page load; a reload applies a changed answer either way.
      if ((value === 'declined') !== (choice === 'declined')) location.reload();
    });

    document.addEventListener('click', function (e) {
      var reopen = e.target instanceof Element ? e.target.closest('[data-cookie-reopen]') : null;
      if (!reopen) return;
      e.preventDefault();
      notice.hidden = false;
    });
  })();
</script>
